{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "product-api-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/catalog/{**catch-all}" }
      },
      "product-swagger-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/product-docs/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/swagger/{**catch-all}" }]
      },
      "cart-api-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/cart/{**catch-all}" }
      },
      "cart-swagger-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/cart-docs/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/swagger/{**catch-all}" }]
      },
      "order-api-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/order/{**catch-all}" }
      },
      "order-swagger-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/order-docs/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/swagger/{**catch-all}" }]
      },
      "user-api-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/user/{**catch-all}" }
      },
      "auth-api-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "admin-api-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      },
      "user-swagger-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/user-docs/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/swagger/{**catch-all}" }]
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": { "node1": { "Address": "http://product_api:80" } }
      },
      "cart-cluster": {
        "Destinations": { "node1": { "Address": "http://cart_api:80" } }
      },
      "order-cluster": {
        "Destinations": { "node1": { "Address": "http://order_api:80" } }
      },
      "user-cluster": {
        "Destinations": { "node1": { "Address": "http://user_api:80" } }
      }
    }
  }
}
