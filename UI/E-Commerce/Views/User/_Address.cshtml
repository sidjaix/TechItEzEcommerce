@model UserPageViewModel
@{
    ViewData["Title"] = "User - Address";
}
<!-- Addresses -->
<div class="tab-pane fade" id="addresses" role="tabpanel" aria-labelledby="addresses-tab">
    <div id="addressList" class="">
        <div class="row mb-3">
            @foreach (var address in Model.Addresses)
            {
                <div class="col-lg-6">
                    <!-- Card -->
                    <div class="card card-lg bg-light mb-4">
                        <div class="card-body">
                            <!-- Heading -->
                            <h5 class="mb-4">@address.FullName</h5>
                            <!-- Text -->
                            <p class="text-muted mb-0">
                                @* FirstName LastName <br> *@
                                @address.UnitNumber, @address.AreaOrStreet <br>
                                @address.Landmark <br>
                                @address.TownOrCity <br>
                                @address.State <br>
                                @address.Pincode
                            </p>
                            <!-- Action -->
                            <div class="card-action card-action-end">
                                <!-- Button -->
                                <a class="btn btn-xs btn-circle btn-white-primary btnEditAddress"
                                    data-url=@Url.Action("GetAddress", new { addressId = address.AddressId })>
                                    <i class="fa fa-edit fa-lg"></i>
                                </a>
                                <!-- Button -->
                                <a class="btn btn-xs btn-circle btn-white-primary" asp-controller="User"
                                    asp-action="DeleteAddress" asp-route-addressId="@address.AddressId">
                                    <i class="fa fa-trash fa-lg"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="row">
            <div class="col-12">
                <!-- Button -->
                <button class="site-btn w-100" id="addAddressButton">
                    Add Address <i class="fa fa-plus"></i>
                </button>
            </div>
        </div>
    </div>
    <div id="addressForm" class="d-none">
        <partial name="_AddressForm" model="@Model.Address"></partial>
    </div>
</div>