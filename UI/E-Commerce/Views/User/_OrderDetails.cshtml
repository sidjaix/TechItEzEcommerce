@model OrderViewModel
@{
    ViewData["Title"] = "User - Order";
}
<div class="col-12">

    <!-- Order -->
    <div class="card card-lg mb-5 border">
        <div class="card-body pb-0">

            <!-- Info -->
            <div class="card card-sm">
                <div class="card-body bg-light">
                    <div class="row">
                        <div class="col-6 col-lg-3">

                            <!-- Heading -->
                            <h6 class="heading-xxxs text-muted">Order No:</h6>

                            <!-- Text -->
                            <p class="mb-lg-0 fs-sm fw-bold">
                                @Model.OrderId
                            </p>

                        </div>
                        <div class="col-6 col-lg-3">

                            <!-- Heading -->
                            <h6 class="heading-xxxs text-muted">Shipped date:</h6>

                            <!-- Text -->
                            <p class="mb-lg-0 fs-sm fw-bold">
                                <time datetime="@Model.OrderDate"> @Model.OrderDate.ToString("dd MMM, yyyy")</time>
                            </p>

                        </div>
                        <div class="col-6 col-lg-3">

                            <!-- Heading -->
                            <h6 class="heading-xxxs text-muted">Status:</h6>

                            <!-- Text -->
                            <p class="mb-0 fs-sm fw-bold">
                                @Model.Status
                            </p>

                        </div>
                        <div class="col-6 col-lg-3">

                            <!-- Heading -->
                            <h6 class="heading-xxxs text-muted">Order Amount:</h6>

                            <!-- Text -->
                            <p class="mb-0 fs-sm fw-bold">
                                ₹@Model.OrderTotal
                            </p>

                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="card-footer">

            <!-- Heading -->
            <h6 class="mb-7 fw-bold">Order Items (@Model.OrderDetails.Count)</h6>
            <!-- Divider -->
            <hr class="my-5">

            <!-- List group -->
            <ul class="list-group list-group-lg list-group-flush-y list-group-flush-x">
                @foreach (var orderItem in Model.OrderDetails)
                {
                    <li class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col-4 col-md-3 col-xl-2">

                                <!-- Image -->
                                <a asp-controller="product" asp-action="getProductDetail"
                                    asp-route-productId="@orderItem.ProductId"><img
                                        src=@Url.Content(@orderItem.ProductImageUrl) alt="..." class="img-fluid"></a>

                            </div>
                            <div class="col">

                                <!-- Title -->
                                <p class="mb-4 fs-sm fw-bold">
                                    <a class="text-body" asp-controller="product" asp-action="getProductDetail"
                                        asp-route-productId="@orderItem.ProductId">@orderItem.ProductName x
                                        @orderItem.Quantity</a> <br>
                                    <span class="text-muted">₹@orderItem.Price</span>
                                </p>

                                @* <!-- Text -->
                            <div class="fs-sm text-muted">
                            Size: M <br>
                            Color: Red
                            </div> *@

                            </div>
                        </div>
                    </li>
                }
            </ul>

        </div>
    </div>

    <!-- Total -->
    <div class="card card-lg mb-5 border">
        <div class="card-body">

            <!-- Heading -->
            <h6 class="mb-7">Order Total</h6>

            <!-- List group -->
            <ul class="list-group list-group-sm list-group-flush-y list-group-flush-x">
                <li class="list-group-item d-flex">
                    <span>Subtotal</span>
                    <span class="ms-auto">₹@Model.OrderTotal</span>
                </li>
                <li class="list-group-item d-flex">
                    <span>Tax</span>
                    <span class="ms-auto">₹0.00</span>
                </li>
                <li class="list-group-item d-flex">
                    <span>Shipping</span>
                    <span class="ms-auto">₹8.00</span>
                </li>
                <li class="list-group-item d-flex fs-lg fw-bold">
                    <span>Total</span>
                    @{
                        var total = @Model.OrderTotal + 8.00;
                    }
                    <span class="ms-auto">₹@total</span>
                </li>
            </ul>

        </div>
    </div>

    <!-- Details -->
    <div class="card card-lg border">
        <div class="card-body">

            <!-- Heading -->
            <h6 class="mb-7">Billing &amp; Shipping Details</h6>

            <!-- Content -->
            <div class="row">
                <div class="col-12 col-md-4">

                    <!-- Heading -->
                    <p class="mb-4 fw-bold">
                        Billing Address:
                    </p>

                    <p class="mb-7 mb-md-0 text-gray-500">
                        Daniel Robinson, <br>
                        3997 Raccoon Run, <br>
                        Kingston, 45644, <br>
                        United States, <br>
                        6146389574
                    </p>

                </div>
                <div class="col-12 col-md-4">

                    <!-- Heading -->
                    <p class="mb-4 fw-bold">
                        Shipping Address:
                    </p>

                    <p class="mb-7 mb-md-0 text-gray-500">
                        Daniel Robinson, <br>
                        3997 Raccoon Run, <br>
                        Kingston, 45644, <br>
                        United States, <br>
                        6146389574
                    </p>

                </div>
                <div class="col-12 col-md-4">

                    <!-- Heading -->
                    <p class="mb-4 fw-bold">
                        Shipping Method:
                    </p>

                    <p class="mb-7 text-gray-500">
                        Standart Shipping <br>
                        (5 - 7 days)
                    </p>

                    <!-- Heading -->
                    <p class="mb-4 fw-bold">
                        Payment Method:
                    </p>

                    <p class="mb-0 text-gray-500">
                        Debit Mastercard
                    </p>

                </div>
            </div>

        </div>
    </div>

</div>