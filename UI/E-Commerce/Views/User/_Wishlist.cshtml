        34.88-6.943S192 115.1 192 128v255.1c0 12.94-7.781 24.62-19.75 29.58S146.5 415.8 137.4 406.6z">
        </path>
        </svg><!-- <i class="fa fa-caret-left"></i> Font Awesome fontawesome.com -->
        </a>
        </li>
        <li class="page-item active">
        <a class="page-link" href="#">1</a>
