@model IEnumerable<OrderViewModel>
@{
    ViewData["Title"] = "Order";
}

@section Styles {
    <link href="~/css/order.css" rel="stylesheet" />
}
<div class="container mt-4">
    <div class="filter__item">
        <div class="row">
            <div class="col-lg-4 col-md-5">
                <div class="filter__sort">
                    <span>Sort By</span>
                    <select>
                        <option value="1">2024</option>
                        <option value="2">2023</option>
                        <option value="3">2022</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <div class="filter__found">
                    <h6><span></span>@{
                            var orderCount = Model.Count();
                            var orderMessage = orderCount > 0 ? $"{orderCount} Order(s) found" : "No order";
                        }@orderMessage</h6>
                </div>
            </div>
            <div class="col-lg-4 col-md-3">
                <div class="filter__option">
                    <span class="icon_grid-2x2"></span>
                    <span class="icon_ul"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-2">
        @foreach (var order in Model)
        {
            <!-- Card template, repeat this for each order -->
            foreach (var orderDetail in order.OrderDetails)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="order-card">
                        <a asp-controller="order" asp-action="orderDetails" asp-route-orderId="@order.OrderId">
                            <img src="@Url.Content(orderDetail.ProductImageUrl)" alt="Product Image">
                            <div class="order-ProductName">@orderDetail.ProductName</div>
                        </a>
                        <div class="order-date">Order Date: @order.OrderDate.Date.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            }
        }
    </div>
</div>
