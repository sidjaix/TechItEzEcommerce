@{
    var message = TempData["Message"] as string;
    var messageType = TempData["MessageType"] as string; // "success", "error", "warning", "created"
    var alertClass = string.Empty;

    switch (messageType?.ToLower())
    {
        case "success":
            alertClass = "bg-success";
            break;
        case "error":
            alertClass = "bg-danger";
            break;
        case "warning":
            alertClass = "bg-warning";
            break;
        case "created":
            alertClass = "bg-info";
            break;
        default:
            alertClass = "bg-secondary";
            break;
    }
}

@if (!string.IsNullOrEmpty(message))
{
    <div aria-live="polite" aria-atomic="true" class="position-relative">
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1050;">
        <div class="toast @alertClass text-white" role="alert" aria-live="assertive" aria-atomic="true"
            data-bs-delay="2000">
            @* <div class="toast-header text-white @alertClass">
            <i class="bi bi-info-circle me-2"></i>
            <strong class="me-auto">@messageType</strong>
            <small>Just now</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"
            aria-label="Close"></button>
            </div> *@
            <div class="toast-body">
                @message
            </div>
        </div>
    </div>
</div>
}
