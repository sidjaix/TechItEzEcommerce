@model LoginViewModel
@{
  ViewData["Title"] = "Login";
}

<section class='h-100'>
  <div class='container h-100'>
    <div class='row justify-content-sm-center h-100'>
      <div class='col-xxl-4 col-xl-5 col-lg-5 col-md-7 col-sm-9'>
        <div class='text-center my-3'>
          <img src=@Url.Content("~/img/techitezlogo.png") alt='logo' width='100' />
        </div>
        <div class='card shadow-lg'>
          <div class='card-body p-5'>
            <h1 class='fs-4 card-title fw-bold mb-4'>Login</h1>
            <form method="post" class='needs-validation'>
              <div class='mb-3'>
                <label class='mb-2 text-muted' htmlFor='username'>
                  Username
                </label>
                <input asp-for="UserName" class='form-control' autoFocus />
                <span asp-validation-for="UserName" class="text-danger" />
              </div>

              <div class='mb-3'>
                <div class='mb-2 w-100'>
                  <label class='text-muted' htmlFor='password'>
                    Password
                  </label>
                </div>
                <input asp-for="Password" type='password' class='form-control' />
                <span asp-validation-for="Password" class="text-danger" />
              </div>

              <div class='d-flex align-items-center'>
                <div class='form-check'>
                  <input type='checkbox' name='remember' id='remember' class='form-check-input site-form-check-input' />
                  <label htmlFor='remember' class='form-check-label'>
                    Remember Me
                  </label>
                </div>
                <button type='submit' class='btn btn-primary ms-auto'>
                  Login
                </button>
              </div>
            </form>
          </div>
          <div class='card-footer py-3 border-0'>
            <div class='text-center'>
              Don't have an account?
              <a asp-controller="account" asp-action="register" class='btn btn-sm btn-warning text-dark'>
                Create One
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
