@model RegisterModel
@{
  ViewData["Title"] = "Register";
}

<section class='h-100'>
  <div class='container h-100'>
    <div class='row justify-content-sm-center h-100'>
      <div class='col-xxl-5 col-xl-5 col-lg-6 col-md-7 col-sm-6'>
        <div class='text-center my-3'>
          <img src=@Url.Content("~/img/techitezlogo.png") alt='logo' width='100' />
        </div>
        <div class='card shadow-lg'>
          <div class='card-body p-5'>
            <h1 class='fs-4 card-title fw-bold mb-4'>Register</h1>
            <form method="post">
              <div class='input-group mb-3'>
                <span class='input-group-text text-muted'>Name</span>
                <input asp-for='Name' type='text' class='form-control' />
                <span asp-validation-for="Name" class="text-danger" />
              </div>

              <div class='input-group mb-3'>
                <span class='input-group-text text-muted'>Email</span>
                <input asp-for='Email' class='form-control' />
                <span asp-validation-for="Email" class="text-danger" />
              </div>

              <div class='input-group mb-3'>
                <span class='input-group-text text-muted'>PhoneNumber</span>
                <input asp-for='PhoneNumber' type='text' class='form-control' />
                <span asp-validation-for="PhoneNumber" class="text-danger" />
              </div>

              <div class='input-group mb-3'>
                <span class='input-group-text text-muted'>Password</span>
                <input asp-for='Password' type='password' class='form-control' />
                <span asp-validation-for="Password" class="text-danger" />
              </div>

              <div class='input-group mb-3'>
                <span class='input-group-text text-muted'>Confirm Password</span>
                <input asp-for='ConfirmPassword' type='password' class='form-control' />
                <span asp-validation-for="ConfirmPassword" class="text-danger" />
              </div>

              @* <div class='input-group mb-3'>
              <div class='form-check form-check-inline'>
              <input value='Male' class='form-check-input' type='radio' name='gender' id='male' />
              <label class='form-check-label' htmlFor='male'>
              Male
              </label>
              </div>
              <div class='form-check form-check-inline'>
              <input value='Female' class='form-check-input' type='radio' name='gender' id='female' />
              <label class='form-check-label' htmlFor='female'>
              Female
              </label>
              </div>
              </div> *@

              <div class='align-items-center d-flex'>
                <button type='reset' class='btn btn-secondary ms-auto'>
                  Reset
                </button>
                <button type='submit' class='btn btn-primary ms-2'>
                  Register
                </button>
              </div>
            </form>
          </div>
          <div class='card-footer py-3 border-0'>
            <div class='text-center'>
              Already have an account?
              <a asp-controller="account" asp-action="login" class='btn btn-sm btn-warning text-dark'>Login</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}