@model RoleViewModel

@{
    ViewData["Title"] = "Admin - Edit Role";
}

<div class="container mt-4">
    <form asp-action="EditRole" method="post">
        <input hidden asp-for="RoleId" />
        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="RoleName" class="form-label">Role Name</label>
                <input asp-for="RoleName" class="form-control" placeholder="Enter Role name" />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label">Role Description</label>
                <input asp-for="Description" class="form-control" placeholder="Enter Role Description" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12 text-end">
                <button type="submit" class="site-btn">Update Role</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
