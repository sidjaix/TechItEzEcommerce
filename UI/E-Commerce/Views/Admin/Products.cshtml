@model IEnumerable<ProductViewModel>
@{
    ViewData["Title"] = "Product";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <!-- Add Product Button -->
        <a href="@Url.Action("CreateProduct", "Admin")" class="site-btn">Add Product</a>
    </div>

    <!-- Product Grid -->
    <table id="products" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Category</th>
                <th>Name</th>
                <th>Selling Price</th>
                <th>Qty In Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductId</td>
                    <td>@product.CategoryName</td>
                    <td>@product.ProductName</td>
                    <td>@product.SellingPrice</td>
                    <td>@product.QuantityInStock</td>
                    <td class="text-center">
                        <!-- Command actions like Edit/Delete -->
                        <a href="@Url.Action("EditProduct", "Admin", new { productId = product.ProductId })"
                            class="btn btn-sm btn-warning"><i class="fa fa-pencil"></i></a>
                        <a href="@Url.Action("DeleteProduct", "Admin", new { productId = product.ProductId })"
                            class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></a>
                        <a href="@Url.Action("GetProductDetail", "Product", new { productId = product.ProductId })"
                            class="btn btn-sm btn-info"><i class="fa fa-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <!-- Pagination Controls -->
    @* <nav aria-label="Page navigation">
    <ul id="pagination" class="pagination justify-content-center"></ul>
    </nav> *@

    <div class="product__pagination" aria-label="Page navigation"></div>
</div>